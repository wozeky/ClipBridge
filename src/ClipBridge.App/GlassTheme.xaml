<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <SolidColorBrush x:Key="WindowBrush" Color="#0B1020" po:Freeze="True" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#101829" po:Freeze="True" />
  <SolidColorBrush x:Key="TextBrush" Color="#F0F5FF" po:Freeze="True" />
  <SolidColorBrush x:Key="MutedBrush" Color="#AEBED4" po:Freeze="True" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#3C526E" po:Freeze="True" />
  <SolidColorBrush x:Key="CyanBrush" Color="#7CF7F0" po:Freeze="True" />
  <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0.8,1" po:Freeze="True">
    <GradientStop Color="#2B4261" Offset="0" />
    <GradientStop Color="#1A2B43" Offset=".32" />
    <GradientStop Color="#132033" Offset=".72" />
    <GradientStop Color="#1D2341" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
    <GradientStop Color="#789DB9" Offset="0" />
    <GradientStop Color="#3C526E" Offset=".48" />
    <GradientStop Color="#394269" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
    <GradientStop Color="#78F9EC" Offset="0" />
    <GradientStop Color="#79C8FF" Offset=".53" />
    <GradientStop Color="#C4A8FF" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="SurfaceCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style x:Key="GlassCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
    <Setter Property="Background" Value="{StaticResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassRim}" />
  </Style>

  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="Background" Value="#243752" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" CornerRadius="8" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="White" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="White" />
              <Setter TargetName="Face" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Background" Value="#1B2739" />
              <Setter TargetName="Face" Property="BorderBrush" Value="#324257" />
              <Setter Property="Foreground" Value="#9BABBF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NeonButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="{StaticResource NeonBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
    <Setter Property="Foreground" Value="#0B1C2C" />
  </Style>
</ResourceDictionary>
