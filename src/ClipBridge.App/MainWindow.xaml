<Window x:Class="ClipBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Height="760" Width="1050" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <ResourceDictionary Source="GlassTheme.xaml" />
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="MP4 içe aktar"
              Click="Import_Click" VerticalAlignment="Center" />
      <StackPanel>
        <TextBlock Text="ClipBridge" FontSize="32" FontWeight="SemiBold" />
        <Border Width="68" Height="3" CornerRadius="2" Background="{StaticResource NeonBrush}"
                HorizontalAlignment="Left" Margin="2,3,0,0" IsHitTestVisible="False">
          <Border.RenderTransform>
            <ScaleTransform x:Name="BrandMotion" />
          </Border.RenderTransform>
        </Border>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,10">
      <StackPanel>
        <DockPanel Margin="0,0,0,9">
          <Border DockPanel.Dock="Right" CornerRadius="9" Padding="9,4" Background="#17273A"
                  BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
            <TextBlock x:Name="CaptureStatus" Text="Kayıt kapalı" Foreground="{StaticResource CyanBrush}" />
          </Border>
          <TextBlock Text="Oyun yakalama" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel>
          <ComboBox x:Name="CaptureTarget" DisplayMemberPath="Title" Width="235" MinHeight="34" Margin="0,0,8,0"
                    AutomationProperties.Name="Kaydedilecek pencere" ToolTip="Kaydedilecek oyun penceresi" />
          <Button Style="{StaticResource GlassButton}" Content="Yenile" Click="RefreshWindows_Click"
                  Margin="0,0,8,0" AutomationProperties.Name="Pencereleri yenile" />
          <Button x:Name="ArmButton" Style="{StaticResource NeonButton}" Content="Kaydı başlat" Click="Arm_Click"
                  Margin="0,0,8,0" />
          <Button x:Name="SaveReplayButton" Style="{StaticResource GlassButton}" Content="Klip al · F8"
                  Click="SaveReplay_Click" IsEnabled="False" />
        </WrapPanel>
        <TextBlock Text="Oyunun penceresini seç, kaydı başlat ve klip almak için F8’e bas."
                   Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="8,4" Margin="0,0,0,10">
      <Expander x:Name="SettingsPanel" Header="Ayarlar" Expanded="Settings_Expanded" Collapsed="Settings_Collapsed">
        <ScrollViewer MaxHeight="154" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,6,8,8">
            <StackPanel.RenderTransform>
              <TranslateTransform x:Name="SettingsMotion" />
            </StackPanel.RenderTransform>
            <WrapPanel>
              <TextBlock Text="Yükleme servisi" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="ProviderChoice" Width="180" Margin="0,0,16,0">
                <ComboBoxItem Content="Litterbox · 24 saat" />
                <ComboBoxItem Content="Gofile" />
              </ComboBox>
              <TextBlock Text="Hız sınırı (KiB/sn, 0 sınırsız)" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="SpeedLimit" Width="80" />
            </WrapPanel>
            <WrapPanel Margin="0,9,0,0">
              <TextBlock Text="Klip süresi (sn)" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="ReplayLength" Width="70" Margin="0,0,16,0" />
              <TextBlock Text="Oyun etiketi" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="GameName" Width="140" MaxLength="80" />
            </WrapPanel>
            <CheckBox x:Name="DesktopAudio" Content="Sistem sesi (Discord dahil)" Margin="0,7,0,0" />
            <CheckBox x:Name="Microphone" Content="Mikrofonu da kaydet" Margin="0,7,0,0" />
            <CheckBox x:Name="AutoUpload" Content="Yeni klipleri otomatik yükle" Margin="0,9,0,0" />
            <CheckBox x:Name="AutoFallback" Content="Dosya limiti reddinde diğer ücretsiz servisi dene" Margin="0,7,0,0" />
            <CheckBox x:Name="AutoCopy" Content="Hazır bağlantıları otomatik panoya kopyala" Margin="0,7,0,0" />
            <CheckBox x:Name="StartWithWindows" Content="Windows oturumunda tepside başlat" Margin="0,7,0,0" />
            <TextBlock Text="Paylaşım bağlantısına sahip kişiler yüklenen klipleri görebilir."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
            <Button Style="{StaticResource GlassButton}" Content="Ayarları kaydet" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,9,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource SurfaceCard}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Klip arşivi" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
        <DataGrid x:Name="Library" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionChanged="Library_SelectionChanged" MouseDoubleClick="Open_Click">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Klip" Binding="{Binding Title}" Width="2*" />
            <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="130" />
            <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="65" />
            <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" Width="75" />
            <DataGridTextColumn Header="Servis" Binding="{Binding Clip.Provider}" Width="92" />
            <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="1.7*" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="1" Text="Henüz klip yok. F8 ile klip al veya bir MP4 içe aktar."
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,20,8,0"
                   Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems, ElementName=Library}" Value="False">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>

    <Border Grid.Row="4" Style="{StaticResource SurfaceCard}" Margin="0,10,0,0">
      <DockPanel>
        <Image x:Name="Thumbnail" DockPanel.Dock="Right" Width="120" Height="68" Visibility="Collapsed"
               Margin="10,0,0,0" Stretch="Uniform" AutomationProperties.Name="Klip küçük resmi" />
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource GlassButton}" x:Name="OpenButton" Content="Videoyu aç" Click="Open_Click" Margin="0,0,8,6" />
            <Button Style="{StaticResource GlassButton}" x:Name="CopyButton" Content="Bağlantıyı kopyala" Click="Copy_Click" Margin="0,0,8,6" />
            <Button Style="{StaticResource GlassButton}" x:Name="UploadButton" Content="Yükle / yeniden dene" Click="Upload_Click" Margin="0,0,8,6" />
            <Button Style="{StaticResource GlassButton}" Content="Klip klasörü" Click="Folder_Click" Margin="0,0,8,6" />
            <Button Style="{StaticResource GlassButton}" x:Name="RecoverClipsButton" Content="Klip klasörünü tara" Click="RecoverClips_Click" Margin="0,0,8,6" />
            <Button Style="{StaticResource GlassButton}" x:Name="DiagnosticsButton" Content="Tanılama raporunu kopyala" Click="CopyDiagnostics_Click" Margin="0,0,0,6" />
          </WrapPanel>
          <ProgressBar x:Name="UploadProgress" Height="4" Margin="0,9,0,0" Minimum="0" Maximum="100"
                       Visibility="Collapsed" />
          <TextBlock Text="{Binding ElementName=Library, Path=SelectedItem.ShareLabel}"
                     ToolTip="{Binding ElementName=Library, Path=SelectedItem.ShareLabel}"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="StatusMessage" Text="MP4 içe aktararak başlayabilirsiniz." TextWrapping="Wrap"
                     Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
