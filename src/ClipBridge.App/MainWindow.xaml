<Window x:Class="ClipBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBridge" Height="760" Width="1100" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <ResourceDictionary Source="GlassTheme.xaml" />
  </Window.Resources>

  <!-- Preserve the native Windows title bar, resize, snap and DPI behavior. -->
  <Grid Margin="22,18,22,18" Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Product identity and the existing import action. -->
    <DockPanel Grid.Row="0" Margin="1,0,1,18" LastChildFill="True">
      <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}"
              Content="MP4 içe aktar" Click="Import_Click"
              VerticalAlignment="Center" Padding="16,9" />
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="3" Height="36" CornerRadius="2"
                Background="{StaticResource AccentBrush}" Margin="0,0,14,0">
          <Border.RenderTransform>
            <ScaleTransform x:Name="BrandMotion" />
          </Border.RenderTransform>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ClipBridge" FontSize="25" FontWeight="SemiBold"
                     LineHeight="30" />
          <TextBlock Text="Kayıt, klip arşivi ve paylaşım"
                     FontSize="12" Foreground="{StaticResource MutedBrush}"
                     Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Recording: no mock states or new backend dependencies. -->
    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,15">
          <Border DockPanel.Dock="Right" CornerRadius="7" Padding="10,5"
                  Background="#233044" BorderBrush="{StaticResource OutlineBrush}"
                  BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="CaptureStatus" Text="Kayıt kapalı"
                       FontSize="12" FontWeight="Medium"
                       Foreground="#BCCAF4" />
          </Border>
          <StackPanel>
            <TextBlock Text="Oyun yakalama" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Pencereyi seç ve son anları F8 ile kaydet."
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1">
          <ComboBox x:Name="CaptureTarget" DisplayMemberPath="Title"
                    Width="255" MinHeight="36" Margin="0,0,8,7"
                    AutomationProperties.Name="Kaydedilecek pencere"
                    ToolTip="Kaydedilecek oyun penceresi" />
          <Button Style="{StaticResource GlassButton}" Content="Yenile"
                  Click="RefreshWindows_Click" Margin="0,0,8,7" />
          <Button x:Name="ArmButton" Style="{StaticResource PrimaryButton}"
                  Content="Kaydı başlat" Click="Arm_Click"
                  Padding="16,7" Margin="0,0,8,7" />
          <Button x:Name="SaveReplayButton" Style="{StaticResource GlassButton}"
                  Content="Klip al · F8" Click="SaveReplay_Click"
                  Margin="0,0,0,7" IsEnabled="False" />
        </WrapPanel>
        <TextBlock Grid.Row="2" Margin="0,0,0,0"
                   Foreground="{StaticResource SubtleBrush}" FontSize="12"
                   TextWrapping="Wrap"
                   Text="Kaydı başlattıktan sonra kısayol çalışır. Klipler yerel arşive kaydedilir." />
      </Grid>
    </Border>

    <!-- Settings intentionally retain the original controls, names, and save semantics. -->
    <Border Grid.Row="2" Style="{StaticResource SurfaceCard}"
            Padding="12,6" Margin="0,0,0,12">
      <Expander x:Name="SettingsPanel" Header="Kayıt ve paylaşım ayarları"
                FontWeight="Medium"
                Expanded="Settings_Expanded" Collapsed="Settings_Collapsed">
        <ScrollViewer MaxHeight="177" Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,2,8,9">
            <StackPanel.RenderTransform>
              <TranslateTransform x:Name="SettingsMotion" />
            </StackPanel.RenderTransform>

            <WrapPanel>
              <TextBlock Text="Yükleme servisi" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,8,7" />
              <ComboBox x:Name="ProviderChoice" Width="180" Margin="0,0,19,7">
                <ComboBoxItem Content="Litterbox · 24 saat" />
                <ComboBoxItem Content="Gofile" />
              </ComboBox>
              <TextBlock Text="Hız sınırı (KiB/sn, 0 sınırsız)"
                         Foreground="{StaticResource MutedBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,7" />
              <TextBox x:Name="SpeedLimit" Width="88" Margin="0,0,0,7" />
            </WrapPanel>

            <WrapPanel Margin="0,5,0,0">
              <TextBlock Text="Klip süresi (sn)" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,8,7" />
              <ComboBox x:Name="ReplayLength" Width="82" Margin="0,0,19,7" />
              <TextBlock Text="Oyun etiketi" VerticalAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" Margin="0,0,8,7" />
              <TextBox x:Name="GameName" Width="158" MaxLength="80"
                       Margin="0,0,0,7" />
            </WrapPanel>

            <WrapPanel Margin="0,7,0,0">
              <StackPanel Margin="0,0,26,0">
                <CheckBox x:Name="DesktopAudio"
                          Content="Sistem sesi (Discord dahil)" Margin="0,0,0,5" />
                <CheckBox x:Name="Microphone"
                          Content="Mikrofonu da kaydet" Margin="0,0,0,5" />
                <CheckBox x:Name="AutoUpload"
                          Content="Yeni klipleri otomatik yükle" Margin="0,0,0,5" />
              </StackPanel>
              <StackPanel>
                <CheckBox x:Name="AutoFallback"
                          Content="Dosya limiti reddinde diğer ücretsiz servisi dene"
                          Margin="0,0,0,5" />
                <CheckBox x:Name="AutoCopy"
                          Content="Hazır bağlantıları otomatik panoya kopyala"
                          Margin="0,0,0,5" />
                <CheckBox x:Name="StartWithWindows"
                          Content="Windows oturumunda tepside başlat"
                          Margin="0,0,0,5" />
              </StackPanel>
            </WrapPanel>

            <TextBlock Text="Paylaşım bağlantısına sahip kişiler yüklenen klipleri görebilir."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource SubtleBrush}" Margin="0,10,0,0" />
            <Button Style="{StaticResource GlassButton}" Content="Ayarları kaydet"
                    Click="SaveSettings_Click" HorizontalAlignment="Left"
                    Margin="0,10,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </Border>

    <!-- The library remains a virtualized, keyboard-accessible WPF DataGrid. -->
    <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="16,13,16,12"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,0,0,1">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="Çift tıkla: videoyu aç"
                       FontSize="12" Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Text="Klip arşivi" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Grid Grid.Row="1">
          <DataGrid x:Name="Library" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionMode="Single" IsReadOnly="True" HeadersVisibility="Column"
                    RowHeaderWidth="0" EnableRowVirtualization="True"
                    EnableColumnVirtualization="True" AlternationCount="2"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionChanged="Library_SelectionChanged"
                    MouseDoubleClick="Open_Click">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Klip" Binding="{Binding Title}" Width="2*" />
              <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="125" />
              <DataGridTextColumn Header="Süre" Binding="{Binding Duration}" Width="66" />
              <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" Width="78" />
              <DataGridTextColumn Header="Servis" Binding="{Binding Clip.Provider}" Width="96" />
              <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="1.5*" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="16,16,16,16" IsHitTestVisible="False">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasItems, ElementName=Library}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="Henüz klip yok" HorizontalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="F8 ile klip al veya bir MP4 içe aktar."
                       HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- Existing selected-clip commands, upload progress and status remain intact. -->
    <Border Grid.Row="4" Style="{StaticResource SurfaceCard}"
            Background="{StaticResource RaisedBrush}" Margin="0,12,0,0"
            Padding="13,12">
      <DockPanel LastChildFill="True">
        <Image x:Name="Thumbnail" DockPanel.Dock="Right" Width="118" Height="66"
               Visibility="Collapsed" Margin="12,0,0,0" Stretch="Uniform"
               AutomationProperties.Name="Klip küçük resmi" />
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource GlassButton}" x:Name="OpenButton"
                    Content="Videoyu aç" Click="Open_Click" Margin="0,0,8,7" />
            <Button Style="{StaticResource GlassButton}" x:Name="CopyButton"
                    Content="Bağlantıyı kopyala" Click="Copy_Click" Margin="0,0,8,7" />
            <Button Style="{StaticResource GlassButton}" x:Name="UploadButton"
                    Content="Yükle / yeniden dene" Click="Upload_Click" Margin="0,0,8,7" />
            <Button Style="{StaticResource GlassButton}" Content="Klip klasörü"
                    Click="Folder_Click" Margin="0,0,8,7" />
            <Button Style="{StaticResource GlassButton}" x:Name="RecoverClipsButton"
                    Content="Klip klasörünü tara" Click="RecoverClips_Click"
                    Margin="0,0,8,7" />
            <Button Style="{StaticResource GlassButton}" x:Name="DiagnosticsButton"
                    Content="Tanılama raporunu kopyala" Click="CopyDiagnostics_Click"
                    Margin="0,0,0,7" />
          </WrapPanel>
          <ProgressBar x:Name="UploadProgress" Height="4" Margin="0,5,0,8"
                       Minimum="0" Maximum="100" Visibility="Collapsed" />
          <TextBlock Text="{Binding ElementName=Library, Path=SelectedItem.ShareLabel}"
                     ToolTip="{Binding ElementName=Library, Path=SelectedItem.ShareLabel}"
                     TextTrimming="CharacterEllipsis" FontSize="12"
                     Foreground="{StaticResource MutedBrush}" />
          <TextBlock x:Name="StatusMessage" Text="MP4 içe aktararak başlayabilirsiniz."
                     TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>