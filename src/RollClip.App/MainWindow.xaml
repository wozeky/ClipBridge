<Window x:Class="RollClip.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RollClip.App"
 AllowDrop="True" DragOver="Import_DragOver" Drop="Import_Drop" Title="RollClip" Width="1280" Height="960" MinWidth="900" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#020303" Foreground="#E8EBE8" FontFamily="Segoe UI Variable, Segoe UI" FontSize="12"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary Source="GlassTheme.xaml"/></Window.Resources>
 <Grid x:Name="RootSurface" Background="#020303">
  <Viewbox Stretch="Uniform">
   <!-- Keep the material and panels in the same coordinate space while reducing outer padding. -->
   <Canvas Width="940" Height="705" ClipToBounds="True">
   <Grid x:Name="Scene" Width="1200" Height="900" Canvas.Left="-130" Canvas.Top="-97.5">
    <Grid x:Name="ChromeScene" IsHitTestVisible="False">
     <Image x:Name="ChromePoster" Source="Assets/ChromePoster.png" Stretch="Fill"/>
     <MediaElement x:Name="ChromeMovie" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Volume="0"
      Stretch="Fill" MediaOpened="Chrome_Opened" MediaEnded="Chrome_Ended" MediaFailed="Chrome_Failed"/>
    </Grid>
    <Canvas x:Name="HomePanel">
     <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
     <Ellipse x:Name="HomeGlow" Canvas.Left="620" Canvas.Top="512" Width="165" Height="90" Opacity=".7" IsHitTestVisible="False">
      <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#5B70FF26"/><GradientStop Color="#0070FF26" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
     </Ellipse>
     <!-- Coordinates measured from the 1600 × 1200 reference at 75% scale. -->
     <StackPanel Canvas.Left="178" Canvas.Top="295" Orientation="Horizontal">
      <Button Style="{StaticResource RoundButton}" Click="Home_Click" ToolTip="Ana ekran" AutomationProperties.Name="Ana ekran" Content="&#xE714;" Foreground="{StaticResource NeonBrush}"/>
      <StackPanel Margin="12,3,0,0"><TextBlock Text="Klip al, kes, Discord’a gönder." Style="{StaticResource Caption}"/>
       <TextBlock Text="RollClip" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/>
      </StackPanel>
     </StackPanel>
     <Button Canvas.Left="465" Canvas.Top="295" Style="{StaticResource RoundButton}" Content="&#xE9CE;" Click="CopyDiagnostics_Click" ToolTip="Tanılama raporunu kopyala" AutomationProperties.Name="Tanılama raporunu kopyala"/>
     <Button Canvas.Left="529" Canvas.Top="295" Style="{StaticResource RoundButton}" Content="&#xE80A;" Click="Library_Click" ToolTip="Klip arşivi" AutomationProperties.Name="Klip arşivi"/>

     <local:ChromeGlass Canvas.Left="178" Canvas.Top="362" Width="402" Height="55" Radius="28">
      <Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Style="{StaticResource RoundButton}" Width="38" Height="38" Content="&#xE72C;" Click="RefreshWindows_Click" ToolTip="Pencereleri yenile" AutomationProperties.Name="Pencereleri yenile"/>
       <ComboBox x:Name="CaptureTarget" Tag="Oyun penceresini seç" Grid.Column="1" DisplayMemberPath="Title" Margin="7,0,3,0" AutomationProperties.Name="Kaydedilecek pencere" ToolTip="Kaydedilecek oyun penceresi"/>
      </Grid>
     </local:ChromeGlass>
     <local:ChromeGlass Canvas.Left="178" Canvas.Top="433" Width="402" Height="174" Radius="38">
      <Grid Margin="27,23,27,19"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="Klip süresi" FontWeight="SemiBold" FontSize="17"/>
       <TextBlock Grid.Row="1" Text="Son anları tek tuşla kaydet." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
       <ListBox x:Name="ReplayLength" Grid.Row="2" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Center" AutomationProperties.Name="Klip süresi, saniye">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#7C837B"/><Setter Property="FontSize" Value="14"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="DurationFace" Height="53" Background="Transparent">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="FontSize" Value="29"/><Setter Property="Foreground" Value="#F1F5EF"/>
          <Setter TargetName="DurationFace" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00CDD5CE" Offset="0"/><GradientStop Color="#24CDD5CE" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
         </Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DurationFace" Property="BorderBrush" Value="{StaticResource NeonBrush}"/><Setter TargetName="DurationFace" Property="BorderThickness" Value="0,0,0,1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style></ListBox.ItemContainerStyle>
       </ListBox>
      </Grid>
     </local:ChromeGlass>
     <local:ChromeGlass Canvas.Left="620" Canvas.Top="305" Width="196" Height="196" Radius="36">
      <Grid ClipToBounds="True">
       <StackPanel Margin="25,24,18,0" VerticalAlignment="Top"><TextBlock Text="Kayıt" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="CaptureStatus" Text="Kayıt kapalı" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="147" HorizontalAlignment="Left"/>
       </StackPanel>
       <Button ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" x:Name="ArmButton" Style="{StaticResource ArmSwitch}" Content="Kaydı başlat" Click="Arm_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,20,0"/>
       <Button ToolTipService.ShowOnDisabled="True" x:Name="SaveReplayButton" Style="{StaticResource GlassButton}" Content="F8" FontSize="32" FontWeight="Light" IsEnabled="False" Click="SaveReplay_Click" ToolTip="Son klibi MP4 olarak kaydet" AutomationProperties.Name="Klip al · F8"
        Width="100" Height="86" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="10,0,0,-7" RenderTransformOrigin=".5,.5">
        <Button.RenderTransform><TransformGroup><SkewTransform AngleX="-12"/><RotateTransform Angle="-25"/></TransformGroup></Button.RenderTransform>
        <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#686F6E" Offset="0"/><GradientStop Color="#111615" Offset=".18"/><GradientStop Color="#060908" Offset=".8"/><GradientStop Color="#757C78" Offset="1"/></LinearGradientBrush></Button.Background>
       </Button>
      </Grid>
     </local:ChromeGlass>
     <local:ChromeGlass Canvas.Left="827" Canvas.Top="305" Width="196" Height="196" Radius="36">
      <Grid ClipToBounds="True">
       <StackPanel Margin="25,23,20,0" VerticalAlignment="Top"><TextBlock Text="Paylaşım" FontSize="17" FontWeight="SemiBold"/>
        <CheckBox x:Name="AutoUpload" Content="Otomatik" Click="QuickSettings_Click" ToolTip="Yeni klipleri otomatik yükle"/>
       </StackPanel>
       <Button ToolTipService.ShowOnDisabled="True" x:Name="QuickUploadButton" Click="LatestClip_Click" IsEnabled="False" ToolTip="Son klibi kes ve paylaş" AutomationProperties.Name="Son klibi kes ve paylaş" Width="153" Height="84" VerticalAlignment="Bottom" Margin="0,0,0,10" Cursor="Hand">
        <Button.Template><ControlTemplate TargetType="Button">
         <Grid><Ellipse Margin="0,22,0,0" Stroke="#7D8381" StrokeThickness="1"><Ellipse.Fill><LinearGradientBrush><GradientStop Color="#080A09" Offset="0"/><GradientStop Color="#6D7370" Offset=".18"/><GradientStop Color="#141815" Offset=".35"/><GradientStop Color="#030504" Offset=".74"/><GradientStop Color="#6F7673" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
          <Ellipse Margin="0,0,0,22" Stroke="#C2C8C5" StrokeThickness="1.4"><Ellipse.Fill><LinearGradientBrush StartPoint=".3,0" EndPoint=".65,1"><GradientStop Color="#7C827F" Offset="0"/><GradientStop Color="#EEF1EF" Offset=".15"/><GradientStop Color="#3F4441" Offset=".25"/><GradientStop Color="#080B09" Offset=".52"/><GradientStop Color="#1D211E" Offset=".82"/><GradientStop Color="#B9C2BD" Offset="1"/></LinearGradientBrush></Ellipse.Fill></Ellipse>
          <TextBlock x:Name="Glyph" Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-22,0,0"/>
         </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource NeonBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Glyph" Property="Foreground" Value="#69746A"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Button.Template>
       </Button>
      </Grid>
     </local:ChromeGlass>
     <local:ChromeGlass Canvas.Left="632" Canvas.Top="518" Width="382" Height="82" Radius="40">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Button ToolTip="Ana ekran" Style="{StaticResource NeonButton}" Click="Home_Click" Height="48" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource NeonBrush}" Margin="0,0,8,0"/><TextBlock Text="Ana ekran" FontSize="11"/></StackPanel></Button>
       <Button Style="{StaticResource RoundButton}" Content="&#xE8F1;" Click="Library_Click" Margin="3,0" ToolTip="Klip arşivi" AutomationProperties.Name="Klip arşivi"/>
       <Button x:Name="SettingsNav" Style="{StaticResource RoundButton}" Content="&#xE713;" Click="Settings_Click" Margin="3,0" ToolTip="Ayarlar" AutomationProperties.Name="Ayarlar"/>
       <Button Style="{StaticResource RoundButton}" Content="&#xE710;" Click="Import_Click" Margin="3,0" ToolTip="MP4 içe aktar" AutomationProperties.Name="MP4 içe aktar"/>
       <Button x:Name="DiagnosticsButton" Style="{StaticResource RoundButton}" Content="&#xE9D9;" Click="CopyDiagnostics_Click" Margin="3,0" ToolTip="Tanılama raporunu kopyala" AutomationProperties.Name="Tanılama raporunu kopyala"/>
      </StackPanel>
     </local:ChromeGlass>
    </Canvas>

    <!-- Functional secondary screens overlay the measured home composition. -->
    <Canvas x:Name="SettingsPanel" Visibility="Collapsed">
     <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
     <local:ChromeGlass Canvas.Left="178" Canvas.Top="245" Width="845" Height="420" Radius="36">
      <Grid Margin="28">
       <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/><RowDefinition Height="47"/></Grid.RowDefinitions>
       <TextBlock Text="Ayarlar" FontSize="20" FontWeight="SemiBold"/>
       <Button Style="{StaticResource RoundButton}" Width="34" Height="34" Content="&#xE711;" Click="Home_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Ana ekrana dön" AutomationProperties.Name="Ayarları kapat"/>
       <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="KAYIT" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
         <TextBlock Text="Kayıt kalitesi" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
         <ComboBox x:Name="RecordingQualityChoice" AutomationProperties.Name="Kayıt kalitesi" ToolTip="Yazılımsal kodlayıcı 720p30 ile sınırlıdır.">
          <ComboBoxItem Content="Yüksek · 1080p60"/>
          <ComboBoxItem Content="Dengeli · 1080p30"/>
          <ComboBoxItem Content="Hafif · 720p30"/>
         </ComboBox>
         <TextBlock Text="Yakalama yöntemi" Style="{StaticResource Caption}" Margin="0,9,0,4"/>
         <ComboBox x:Name="CaptureMethodChoice" AutomationProperties.Name="Yakalama yöntemi">
          <ComboBoxItem Content="Otomatik · WGC → GDI"/><ComboBoxItem Content="WGC · Pencere"/>
          <ComboBoxItem Content="DXGI · Ekran 0 (tüm ekran)"/><ComboBoxItem Content="GDI · Pencere"/>
         </ComboBox>
         <TextBlock Text="Klip kısayolu" Style="{StaticResource Caption}" Margin="0,9,0,4"/>
         <ComboBox x:Name="ReplayKeyChoice" AutomationProperties.Name="Klip kısayolu"/>
         <TextBlock Text="EK KLİP KISAYOLLARI" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
         <ComboBox x:Name="ShortcutList" SelectionChanged="ShortcutList_Changed" AutomationProperties.Name="Ek kısayollar"/>
         <WrapPanel Margin="0,4,0,0">
          <ComboBox x:Name="ShortcutKey" Width="62" Margin="0,0,4,4" AutomationProperties.Name="Ek kısayol tuşu"/>
          <CheckBox x:Name="ShortcutCtrl" Content="Ctrl" AutomationProperties.Name="Ctrl"/>
          <CheckBox x:Name="ShortcutShift" Content="Shift" AutomationProperties.Name="Shift"/>
          <ComboBox x:Name="ShortcutLength" Width="74" Margin="0,0,4,4" AutomationProperties.Name="Ek kısayol süresi"/>
         </WrapPanel>
         <WrapPanel>
          <Button Style="{StaticResource GlassButton}" Content="Yeni" Click="NewShortcut_Click" Margin="0,0,4,4"/>
          <Button Style="{StaticResource GlassButton}" Content="Ekle / uygula" Click="ApplyShortcut_Click" Margin="0,0,4,4"/>
          <Button Style="{StaticResource GlassButton}" Content="Kaldır" Click="RemoveShortcut_Click" Margin="0,0,4,4"/>
         </WrapPanel>
         <TextBlock x:Name="ShortcutStatus" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
         <TextBlock Text="Oyun etiketi" Style="{StaticResource Caption}" Margin="0,9,0,6"/><TextBox x:Name="GameName" MaxLength="80" AutomationProperties.Name="Oyun etiketi"/>
         <CheckBox x:Name="DesktopAudio" Content="Sistem sesi (Discord dahil)"/>
         <CheckBox x:Name="GameOnlyAudio" Content="Sistem sesi yerine yalnız seçili oyunun sesi"/>
         <CheckBox x:Name="Microphone" Content="Mikrofonu ayrı kaydet"/>
         <TextBlock Text="Mikrofon aygıtı" Style="{StaticResource Caption}"/>
         <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Content="Yenile" Click="RefreshMicrophones_Click" Margin="5,0,0,0"/>
          <ComboBox x:Name="MicrophoneDevice" AutomationProperties.Name="Mikrofon aygıtı"/>
         </DockPanel>
         <TextBlock x:Name="AudioDeviceStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
         <DockPanel><TextBlock DockPanel.Dock="Left" Text="Oyun / sistem %" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SystemGain, StringFormat=F0}" Width="32"/>
          <Slider x:Name="SystemGain" Minimum="0" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Oyun ve sistem ses seviyesi"/>
         </DockPanel>
         <DockPanel><TextBlock DockPanel.Dock="Left" Text="Mikrofon %" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=MicrophoneGain, StringFormat=F0}" Width="32"/>
          <Slider x:Name="MicrophoneGain" Minimum="0" Maximum="200" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Mikrofon seviyesi"/>
         </DockPanel>
         <CheckBox x:Name="AutoGame" Content="Seçilen oyun açılınca kaydı başlat"/>
         <TextBlock Text="OYUN PROFİLLERİ" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <ComboBox x:Name="GameProfilesChoice" AutomationProperties.Name="Kayıtlı oyun profilleri"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="Seçili oyun için kaydet" Click="SaveGameProfile_Click" Style="{StaticResource GlassButton}" Margin="0,0,5,4"/>
          <Button Content="Profili yükle" Click="LoadGameProfile_Click" Style="{StaticResource GlassButton}" Margin="0,0,5,4"/>
          <Button Content="Profili sil" Click="RemoveGameProfile_Click" Style="{StaticResource GlassButton}" Margin="0,0,0,4"/>
         </WrapPanel>
         <CheckBox x:Name="SaveSound" Content="Klip kaydedilince ses çal"/>
         <CheckBox x:Name="SaveNotice" Content="Klip kaydedilince Windows bildirimi"/>
         <Button x:Name="TestClipButton" Content="Test klibi al ve kontrol et" Style="{StaticResource GlassButton}"
          Click="TestClip_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/>
         <TextBlock Text="KLİP KAYNAĞI" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <TextBlock x:Name="ImportFolderLabel" Text="Klasör izleme kapalı" TextTrimming="CharacterEllipsis"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="Klip klasörü izle" Click="WatchFolder_Click" Style="{StaticResource GlassButton}" Margin="0,0,5,4"/>
          <Button Content="İzlemeyi kapat" Click="StopWatching_Click" Style="{StaticResource GlassButton}" Margin="0,0,0,4"/>
         </WrapPanel>
         <TextBlock Text="Yeni MP4’ler yerel arşive alınır. Mevcut klipleri sürükleyip bırakabilirsiniz." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
         <CheckBox x:Name="StartWithWindows" Content="Windows ile tepside başlat"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="PAYLAŞIM" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
         <ComboBox x:Name="ProviderChoice" AutomationProperties.Name="Yükleme servisi"><ComboBoxItem Content="Litterbox · 24 saat"/><ComboBoxItem Content="Gofile"/></ComboBox>
         <Grid Margin="0,10,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="Hız sınırı · KiB/sn" VerticalAlignment="Center"/><TextBox x:Name="SpeedLimit" Grid.Column="1" AutomationProperties.Name="Yükleme hız sınırı" ToolTip="0 = sınırsız"/></Grid>
         <CheckBox x:Name="AutoFallback" Content="Limitte alternatif servisi dene"/>
         <CheckBox x:Name="AutoCopy" Content="Hazır bağlantıyı panoya kopyala"/>
         <TextBlock Text="Bağlantıya sahip kişiler yüklenen klibi görebilir." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
         <TextBlock Text="Dil · Language" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <ComboBox x:Name="LanguageChoice" AutomationProperties.Name="Dil · Language">
          <ComboBoxItem Content="Türkçe"/><ComboBoxItem Content="English"/>
         </ComboBox>
         <TextBlock Text="GÖRÜNÜM" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
         <CheckBox x:Name="MotionEnabled" Content="Hareketli krom arka plan" Click="Motion_Click"/>
         <TextBlock Text="Kayıt sırasında ve arka planda durur." Style="{StaticResource Caption}"/>
         <TextBlock Text="UZUN SÜRELİ ARŞİV" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <TextBlock x:Name="ArchiveState" Text="Otomatik kopya kapalı" FontWeight="SemiBold" Margin="0,0,0,4"/>
         <TextBlock Text="Drive ile eşitlenen bir klasör seçin. Yeni klipler buraya da kopyalanır." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
         <TextBox x:Name="ArchiveFolderBox" IsReadOnly="True" Margin="0,6,0,0" AutomationProperties.Name="Yedek klasörü"/>
         <WrapPanel Margin="0,6,0,0">
          <Button ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Style="{StaticResource GlassButton}" Content="Klasör seç" Click="ChooseArchiveFolder_Click" Margin="0,0,5,4"/>
          <Button ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" x:Name="OpenArchiveButton" Style="{StaticResource GlassButton}" Content="Klasörü aç" Click="OpenArchiveFolder_Click" Margin="0,0,5,4" IsEnabled="False"/>
          <Button ToolTip="Arşiv yedeklemeyi kapat" Style="{StaticResource GlassButton}" Content="Kapat" Click="ClearArchiveFolder_Click" Margin="0,0,5,4"/>
          <Button ToolTipService.ShowOnDisabled="True" x:Name="ArchiveExistingButton" Style="{StaticResource GlassButton}" Content="Eski klipleri yedekle" Click="ArchiveExisting_Click" ToolTip="Mevcut ve daha önce kopyalanamayan klipleri arşive kopyala" IsEnabled="False"/>
         </WrapPanel>
         <TextBlock Text="Bulut yüklemesini Drive yapar. Eşitleme durumunu Drive’dan kontrol edin." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
         <TextBlock x:Name="ArchiveStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock Text="DEPOLAMA" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <TextBlock x:Name="StorageStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
         <WrapPanel>
          <Button Style="{StaticResource GlassButton}" Content="Kullanımı ölç" Click="StorageUsage_Click" Margin="0,0,5,4"/>
          <Button Style="{StaticResource GlassButton}" Content="Küçük resimleri temizle" Click="ClearThumbnails_Click" Margin="0,0,0,4"/>
         </WrapPanel>
         <DockPanel><TextBlock DockPanel.Dock="Left" Text="Klip sınırı (GB)" Margin="0,0,8,0"/>
          <TextBox x:Name="StorageLimit" Text="0" AutomationProperties.Name="Klip depolama sınırı, GB"/>
         </DockPanel>
         <CheckBox x:Name="AutoCleanup" Content="Yedeği doğrulanan eski klipleri otomatik temizle"/>
         <CheckBox x:Name="KeepUnshared" Content="Paylaşılmamış klipleri koru" IsChecked="True"/>
         <TextBlock Text="GÜNCELLEMELER" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
         <TextBlock x:Name="CurrentVersionLabel" FontWeight="SemiBold"/>
         <CheckBox x:Name="AutoUpdates" Content="Güncellemeleri otomatik kontrol et"/>
         <CheckBox x:Name="IncludePreviews" Content="Ön sürümleri dahil et"/>
         <WrapPanel>
          <Button x:Name="CheckUpdateButton" Style="{StaticResource GlassButton}" Content="Kontrol et" Click="CheckUpdate_Click" Margin="0,0,5,4"/>
          <Button Style="{StaticResource GlassButton}" Content="Sürüm notları / indir" Click="OpenRelease_Click" Margin="0,0,0,4"/>
         </WrapPanel>
         <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
       </Grid></ScrollViewer>
       <Button ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" Grid.Row="2" Style="{StaticResource NeonButton}" Content="Ayarları kaydet" Click="SaveSettings_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
     </local:ChromeGlass>
    </Canvas>
    <Canvas x:Name="LibraryPanel" Visibility="Collapsed">
     <Canvas.RenderTransform><TranslateTransform/></Canvas.RenderTransform>
     <local:ChromeGlass Canvas.Left="178" Canvas.Top="245" Width="845" Height="420" Radius="36">
      <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Klip arşivi" FontSize="20" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource GlassButton}" Content="MP4 içe aktar" Click="Import_Click" Margin="0,0,10,0"/>
        <Button Style="{StaticResource RoundButton}" Width="34" Height="34" Content="&#xE711;" Click="Home_Click" ToolTip="Ana ekrana dön" AutomationProperties.Name="Arşivi kapat"/>
       </StackPanel>
       <WrapPanel Grid.Row="1">
        <TextBox x:Name="GallerySearch" Width="155" Margin="0,0,6,4" ToolTip="Klip adına göre ara" AutomationProperties.Name="Klip adına göre ara" TextChanged="GalleryFilter_Changed"/>
        <ComboBox x:Name="GalleryGame" Width="126" Margin="0,0,6,4" AutomationProperties.Name="Oyun filtresi" SelectionChanged="GalleryFilter_Changed"/>
        <ComboBox x:Name="GalleryDate" Width="94" Margin="0,0,6,4" AutomationProperties.Name="Tarih filtresi" SelectionChanged="GalleryFilter_Changed"/>
        <ComboBox x:Name="GalleryUpload" Width="105" Margin="0,0,6,4" AutomationProperties.Name="Yükleme filtresi" SelectionChanged="GalleryFilter_Changed"/>
        <ComboBox x:Name="GallerySort" Width="96" Margin="0,0,6,4" AutomationProperties.Name="Sıralama" SelectionChanged="GalleryFilter_Changed"/>
        <CheckBox x:Name="GalleryFavorites" Content="★" ToolTip="Yalnız favoriler" AutomationProperties.Name="Yalnız favoriler" Click="GalleryFilter_Changed"/>
        <CheckBox x:Name="GalleryGrid" Content="▦" ToolTip="Izgara görünümü" AutomationProperties.Name="Izgara görünümü" Click="GalleryFilter_Changed"/>
       </WrapPanel>
       <ListBox x:Name="Library" Grid.Row="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Library_SelectionChanged" AutomationProperties.Name="Klip arşivi">
        <ListBox.ItemTemplate><DataTemplate>
         <ItemsControl ItemsSource="{Binding}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Button Style="{StaticResource GlassButton}" Margin="2" Padding="6" HorizontalContentAlignment="Stretch" Click="GalleryCard_Click" MouseDoubleClick="GalleryCard_Open">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <Border Background="#101510" CornerRadius="5" Height="45">
              <Grid><TextBlock Text="MP4" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
               <Image Stretch="UniformToFill" ClipToBounds="True" Loaded="GalleryImage_Loaded" Unloaded="GalleryImage_Unloaded" DataContextChanged="GalleryImage_ContextChanged" IsVisibleChanged="GalleryImage_VisibilityChanged"/>
              </Grid>
             </Border>
             <StackPanel Grid.Column="1" Margin="7,0,0,0">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}"/>
              <TextBlock Text="{Binding GalleryStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GalleryStatus}" Style="{StaticResource Caption}"/>
             </StackPanel>
            </Grid>
           </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="GalleryEmpty" Grid.Row="2" Text="Henüz klip yok. Klip al veya bir MP4’ü buraya bırak." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <WrapPanel>
         <Button x:Name="OpenButton" Style="{StaticResource GlassButton}" Content="Kes ve paylaş" Click="Open_Click" Margin="0,0,5,5"/>
         <Button x:Name="CopyButton" Style="{StaticResource GlassButton}" Content="Bağlantıyı kopyala" Click="Copy_Click" Margin="0,0,5,5"/>
         <Button x:Name="UploadButton" Style="{StaticResource GlassButton}" Content="Bağlantı oluştur" Click="Upload_Click" Margin="0,0,5,5"/>
         <Button x:Name="CancelUploadButton" Style="{StaticResource GlassButton}" Content="Yüklemeyi iptal et" Click="CancelUpload_Click" Margin="0,0,5,5" Visibility="Collapsed"/>
         <Button x:Name="FavoriteButton" Style="{StaticResource GlassButton}" Content="Favori" Click="Favorite_Click" Margin="0,0,5,5"/>
         <Button x:Name="ShowLocationButton" Style="{StaticResource GlassButton}" Content="Konumu aç" Click="ShowLocation_Click" Margin="0,0,5,5"/>
         <Button x:Name="DeleteClipButton" Style="{StaticResource GlassButton}" Content="Sil" Click="DeleteClip_Click" Margin="0,0,5,5"/>
         <Button Style="{StaticResource GlassButton}" Content="Klip klasörü" Click="Folder_Click" Margin="0,0,5,5"/>
         <Button x:Name="RecoverClipsButton" Style="{StaticResource GlassButton}" Content="Klasörü tara" Click="RecoverClips_Click" Margin="0,0,5,5"/>
        </WrapPanel>
        <TextBlock x:Name="GallerySelection" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}"/>
       </StackPanel>
      </Grid>
     </local:ChromeGlass>
    </Canvas>
    <StackPanel VerticalAlignment="Top" Margin="205,690,205,0">
     <ProgressBar x:Name="UploadProgress" Height="3" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{StaticResource NeonBrush}" Background="#182019" BorderThickness="0"/>
     <TextBlock x:Name="StatusMessage" Foreground="#9EA59D" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </Grid>
   </Canvas>
  </Viewbox>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,3,8,0">
   <Button Style="{StaticResource GlassButton}" Content="—" MinHeight="27" Height="27" Padding="12,0" Click="Minimize_Click" ToolTip="Küçült" AutomationProperties.Name="Küçült"/>
   <Button Style="{StaticResource GlassButton}" Content="□" MinHeight="27" Height="27" Padding="12,0" Click="Maximize_Click" ToolTip="Büyüt / geri yükle" AutomationProperties.Name="Büyüt veya geri yükle"/>
   <Button Style="{StaticResource GlassButton}" Content="×" MinHeight="27" Height="27" Padding="12,0" Click="Close_Click" ToolTip="Sistem tepsisine gizle" AutomationProperties.Name="Kapat"/>
  </StackPanel>
 </Grid>
</Window>
