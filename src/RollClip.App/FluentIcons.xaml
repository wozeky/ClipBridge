 <Style x:Key="FluentIcon" TargetType="ContentControl">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ContentControl">
    <Viewbox Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}">
     <Canvas Width="24" Height="24">
      <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"/>
     </Canvas>
    </Viewbox>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>

 <!-- Retain the original font metrics where the icon used to size a control.
      Only the vector is painted. The invisible content measures the legacy slot. -->
