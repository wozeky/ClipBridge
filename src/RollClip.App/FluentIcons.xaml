  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="ContentControl">
    <Grid>
     <ContentPresenter Opacity="0"/>
     <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
      <Viewbox Width="12" Height="12" Canvas.Left="-6" Canvas.Top="-6">
       <Canvas Width="24" Height="24">
        <Path x:Name="IconPath" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"/>
       </Canvas>
      </Viewbox>
     </Canvas>
    </Grid>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>

 <Style x:Key="FluentFavoriteMarker" TargetType="ContentControl" BasedOn="{StaticResource FluentMeasuredIcon}">
  <Setter Property="Content" Value="&#x2605;&#xA0;"/>
  <Setter Property="Tag" Value="{StaticResource FluentStarFilled}"/>
  <Setter Property="Visibility" Value="Collapsed"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding Clip.Favorite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="FluentFavoriteFilter" TargetType="ContentControl" BasedOn="{StaticResource FluentMeasuredIcon}">
  <Setter Property="Tag" Value="{StaticResource FluentStar}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
    <Setter Property="Tag" Value="{StaticResource FluentStarFilled}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="FluentGalleryView" TargetType="ContentControl" BasedOn="{StaticResource FluentMeasuredIcon}">
  <Setter Property="Tag" Value="{StaticResource FluentList}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
    <Setter Property="Tag" Value="{StaticResource FluentGrid}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>

 <Style x:Key="FluentWindowSize" TargetType="ContentControl" BasedOn="{StaticResource FluentMeasuredIcon}">
  <Setter Property="Tag" Value="{StaticResource FluentMaximize}"/>
  <Style.Triggers>
   <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
    <Setter Property="Tag" Value="{StaticResource FluentRestore}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
