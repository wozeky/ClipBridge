<Window x:Class="RollClip.App.ClipEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:local="clr-namespace:RollClip.App"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RollClip · Klip editörü" Width="1060" Height="730" MinWidth="860" MinHeight="650"
 WindowStartupLocation="CenterOwner" Background="#111214" Foreground="#F3F4F5" FontSize="13"
 FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True">
 <Window.Resources><ResourceDictionary Source="GlassTheme.xaml"/></Window.Resources>
 <Grid x:Name="EditorSurface" Background="#111214">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>

  <Border Grid.ColumnSpan="2" Background="#191A1D" BorderBrush="#2D2F34" BorderThickness="0,0,0,1" Padding="18,10">
   <DockPanel>
    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Kırpılmış kopyayı kaydet" Style="{StaticResource NeonButton}" Click="Save_Click"/>
    <ContentControl DockPanel.Dock="Left" Style="{StaticResource FluentIcon}" Tag="{StaticResource FluentVideoClip}" Foreground="{StaticResource NeonBrush}" FontSize="20" Margin="0,0,12,0"/>
    <StackPanel>
     <TextBlock Text="Klip editörü" FontFamily="{StaticResource HeadingFont}" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock x:Name="ClipName" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,12,0"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#0B0C0D" BorderBrush="#2D2F34" BorderThickness="1" Margin="18,16,16,12" CornerRadius="8">
   <Grid ClipToBounds="True">
    <Image x:Name="PreviewPoster" Stretch="Uniform"/>
    <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
     Volume="{Binding ElementName=PreviewVolume, Path=Value}" MediaOpened="Preview_Opened" MediaFailed="Preview_Failed" MediaEnded="Preview_Ended"/>
   </Grid>
  </Border>

  <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Background="#191A1D" BorderBrush="#2D2F34" BorderThickness="1,0,0,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="15,14">
     <TextBlock Text="Kırpma" FontFamily="{StaticResource HeadingFont}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
     <DockPanel Margin="0,0,0,6">
      <TextBox x:Name="StartBox" DockPanel.Dock="Right" Width="60" Margin="8,0,0,0" AutomationProperties.Name="Başlangıç, saniye" TextChanged="TrimRange_Changed"/>
      <Button local:UiSounds.Cue="SetStart1" Content="Başlangıcı burada yap" Style="{StaticResource EditorButton}" Click="SetStart_Click"/>
     </DockPanel>
     <DockPanel Margin="0,0,0,12">
      <TextBox x:Name="EndBox" DockPanel.Dock="Right" Width="60" Margin="8,0,0,0" AutomationProperties.Name="Bitiş, saniye" TextChanged="TrimRange_Changed"/>
      <Button local:UiSounds.Cue="SetEnd1" Content="Bitişi burada yap" Style="{StaticResource EditorButton}" Click="SetEnd_Click"/>
     </DockPanel>

     <TextBlock Text="Ses" FontFamily="{StaticResource HeadingFont}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <TextBlock Text="Önizleme ses seviyesi" Style="{StaticResource Caption}"/>
     <Slider x:Name="PreviewVolume" Minimum="0" Maximum="1" Value=".7" Margin="0,5,0,7" AutomationProperties.Name="Önizleme ses seviyesi"/>
     <CheckBox x:Name="IncludeMic" Content="Mikrofonu ekle" IsChecked="True" Margin="0,0,0,5"/>
     <CheckBox x:Name="Mute" Content="Sesi kapat" Margin="0,0,0,12"/>

     <TextBlock Text="Dışa aktarma" FontFamily="{StaticResource HeadingFont}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <ComboBox x:Name="ExportSizeChoice" AutomationProperties.Name="Dosya boyutu hedefi" Margin="0,0,0,7"/>
     <CheckBox x:Name="ReplaceOriginal" Content="Yerel orijinalin yerine kaydet" Margin="0,0,0,8"/>
     <Button x:Name="SendDiscordButton" Content="Discord'a gönder" Style="{StaticResource EditorButton}" Click="SendDiscord_Click" Margin="0,0,0,6"/>
     <Button x:Name="DiscordButton" Content="Paylaşım dosyasını kopyala" Style="{StaticResource EditorButton}" Click="Discord_Click" Margin="0,0,0,6"/>
     <Button x:Name="OpenDiscordMessage" Content="Mesajı aç" Style="{StaticResource EditorButton}" Click="OpenDiscordMessage_Click" Margin="0,0,0,6" Visibility="Collapsed"/>
     <Button x:Name="OpenCopyButton" Content="Paylaşım kopyasını aç" Style="{StaticResource EditorButton}" Click="OpenCopy_Click" IsEnabled="False" Margin="0,0,0,6"/>
     <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource EditorButton}" Click="Cancel_Click" IsEnabled="False"/>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Border Grid.Row="2" Margin="18,0,16,12" Padding="12" CornerRadius="8" Background="#191A1D" BorderBrush="#2D2F34" BorderThickness="1">
   <StackPanel>
    <DockPanel Margin="0,0,0,8">
     <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="PlayButton" Content="Oynat" Width="80" Style="{StaticResource EditorButton}" Click="Play_Click" IsEnabled="False" Margin="0,0,8,0"/>
      <Button x:Name="PreviewRangeButton" Content="Seçimi oynat" Style="{StaticResource EditorButton}" IsEnabled="False" Click="PreviewRange_Click"/>
     </StackPanel>
    </DockPanel>
    <ItemsControl x:Name="TimelineTicks" Margin="0,0,0,4">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Height="54" Background="#26282E" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="Filmstrip_Seek">
     <Image x:Name="Filmstrip" Stretch="Fill"/>
     <Grid IsHitTestVisible="False">
      <Grid.ColumnDefinitions>
       <ColumnDefinition x:Name="BeforeTrim" Width="0"/>
       <ColumnDefinition x:Name="TrimSelection" Width="*"/>
       <ColumnDefinition x:Name="AfterTrim" Width="0"/>
      </Grid.ColumnDefinitions>
      <Border Background="#AD101112"/>
      <Border Grid.Column="1" BorderBrush="{StaticResource NeonBrush}" BorderThickness="1"/>
      <Border Grid.Column="2" Background="#AD101112"/>
     </Grid>
    </Grid>
    <Slider x:Name="Timeline" Minimum="0" IsMoveToPointEnabled="True" ValueChanged="Timeline_Changed" AutomationProperties.Name="Önizleme konumu"/>
    <Canvas x:Name="BookmarkRail" Height="14" Background="#222429" SizeChanged="BookmarkRail_Resized" AutomationProperties.Name="Zaman çizelgesi yer imleri"/>
    <DockPanel Margin="0,6,0,0">
     <Button local:UiSounds.Cue="AddBookmark1" Content="Yer imi ekle" Style="{StaticResource EditorButton}" Click="AddBookmark_Click" DockPanel.Dock="Left" Margin="0,0,8,0"/>
     <Button local:UiSounds.Cue="RemoveBookmark1" Content="Sil" Style="{StaticResource EditorButton}" Click="RemoveBookmark_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
     <ComboBox x:Name="BookmarkChoice" Tag="Yer imleri" SelectionChanged="Bookmark_Changed" AutomationProperties.Name="Yer imine git"/>
    </DockPanel>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#191A1D" Padding="16,8">
   <StackPanel>
    <ProgressBar x:Name="ExportProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Dışa aktarma ilerlemesi"/>
    <TextBlock x:Name="Feedback" TextWrapping="Wrap" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"
     Text="Başlangıç ve bitiş saniye cinsinden. Paylaşım kopyası seçilen boyut sınırına uyar."/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
