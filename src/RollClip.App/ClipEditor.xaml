<Window x:Class="RollClip.App.ClipEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RollClip · Klibi hazırla" Width="720" Height="620" MinWidth="560" MinHeight="540"
 WindowStartupLocation="CenterOwner" Background="#151715" Foreground="#F1F5EF" FontSize="13">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Background="#080908" CornerRadius="8">
   <MediaElement x:Name="Preview" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
    Volume="{Binding ElementName=PreviewVolume, Path=Value}" MediaOpened="Preview_Opened" MediaFailed="Preview_Failed" MediaEnded="Preview_Ended"/>
  </Border>
  <DockPanel Grid.Row="1" Margin="0,10,0,0">
   <Button x:Name="PlayButton" Content="Oynat" Width="78" Click="Play_Click" IsEnabled="False" Margin="0,0,12,0"/>
   <Button x:Name="PreviewRangeButton" Content="Seçimi oynat" IsEnabled="False" Click="PreviewRange_Click" Margin="0,0,8,0" Padding="8,3"/>
   <Slider x:Name="PreviewVolume" DockPanel.Dock="Right" Width="64" Minimum="0" Maximum="1" Value=".7" Margin="6,0,0,0"
    AutomationProperties.Name="Önizleme ses seviyesi" ToolTip="Önizleme ses seviyesi"/>
   <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Width="90" Margin="12,0,0,0" VerticalAlignment="Center"/>
   <Slider x:Name="Timeline" Minimum="0" IsMoveToPointEnabled="True" ValueChanged="Timeline_Changed"
    AutomationProperties.Name="Önizleme konumu"/>
  </DockPanel>
  <StackPanel Grid.Row="2" Margin="0,6,0,0">
   <Canvas x:Name="BookmarkRail" Height="14" Background="#262A26" SizeChanged="BookmarkRail_Resized"
    AutomationProperties.Name="Zaman çizelgesi yer imleri"/>
   <DockPanel Margin="0,5,0,0">
    <Button Content="Yer imi ekle" Click="AddBookmark_Click" DockPanel.Dock="Left" Padding="8,4" Margin="0,0,8,0"/>
    <Button Content="Sil" Click="RemoveBookmark_Click" DockPanel.Dock="Right" Padding="8,4" Margin="8,0,0,0"/>
    <ComboBox x:Name="BookmarkChoice" SelectionChanged="Bookmark_Changed" AutomationProperties.Name="Yer imine git"/>
   </DockPanel>
  </StackPanel>
  <WrapPanel Grid.Row="3" Margin="0,12,0,0">
   <Button Content="Başlangıcı burada yap" Click="SetStart_Click" Padding="8,4" Margin="0,0,8,5"/>
   <TextBox x:Name="StartBox" Width="65" Margin="0,0,14,5" AutomationProperties.Name="Başlangıç, saniye"/>
   <Button Content="Bitişi burada yap" Click="SetEnd_Click" Padding="8,4" Margin="0,0,8,5"/>
   <TextBox x:Name="EndBox" Width="65" Margin="0,0,14,5" AutomationProperties.Name="Bitiş, saniye"/>
   <CheckBox x:Name="IncludeMic" Content="Mikrofonu ekle" IsChecked="True" Foreground="#F1F5EF" Margin="0,4,12,5"/>
   <CheckBox x:Name="Mute" Content="Sesi kapat" Foreground="#F1F5EF" Margin="0,4,0,5"/>
  </WrapPanel>
  <WrapPanel Grid.Row="4" Margin="0,9,0,0">
   <ComboBox x:Name="ExportSizeChoice" Width="112" Margin="0,0,8,5" AutomationProperties.Name="Dosya boyutu hedefi"/>
   <Button x:Name="DiscordButton" Content="Paylaşım dosyasını kopyala" Click="Discord_Click" Padding="12,6" Margin="0,0,8,5"/>
   <Button x:Name="SaveButton" Content="Kırpılmış kopyayı kaydet" Click="Save_Click" Padding="12,6" Margin="0,0,8,5"/>
   <Button x:Name="OpenCopyButton" Content="Paylaşım kopyasını aç" Click="OpenCopy_Click" Padding="10,6" Margin="0,0,8,5" IsEnabled="False"/>
   <Button x:Name="CancelButton" Content="İptal" Click="Cancel_Click" Padding="10,6" IsEnabled="False"/>
  </WrapPanel>
  <StackPanel Grid.Row="5" Margin="0,6,0,0">
   <CheckBox x:Name="ReplaceOriginal" Content="Yerel orijinalin yerine kaydet" Foreground="#F1F5EF" Margin="0,0,0,6"/>
   <ProgressBar x:Name="ExportProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Dışa aktarma ilerlemesi"/>
   <TextBlock x:Name="Feedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
    Text="Başlangıç ve bitiş saniye cinsinden. Paylaşım kopyası seçilen boyut sınırına uyar."/>
  </StackPanel>
 </Grid>
</Window>
